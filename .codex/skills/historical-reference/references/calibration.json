    {"id": "CAL-014", "text": "**Host:** We are joined today by a guest to discuss the Vietnam War and current headlines.", "expected_reference": null, "expected_attribution": "excluded-context", "expected_mechanism": null, "expected_crosswalk": null},
    {"id": "CAL-015", "text": "A quoted commentator said the Bay of Pigs was a failure, but Freeman did not adopt the claim.", "expected_reference": "bay-of-pigs", "expected_attribution": "provisional", "expected_mechanism": "coercion", "expected_crosswalk": "M-FR-001"},
    {"id": "CAL-016", "text": "The phrase Thucydides Trap appeared in a book title, with no comparison to current power relations.", "expected_reference": "thucydides-trap", "expected_attribution": "provisional", "expected_mechanism": "power", "expected_crosswalk": "M-FR-003", "false_analogy": true},
    {"id": "CAL-017", "text": "The Viet Nam war remains a warning about intervention.", "expected_reference": "vietnam-war", "expected_attribution": "provisional", "expected_mechanism": "coercion", "expected_crosswalk": "M-FR-001"},
    {"id": "CAL-018", "text": "The J.C.P.O.A. depended on reciprocal inspection commitments.", "expected_reference": "jcpoa", "expected_attribution": "provisional", "expected_mechanism": "diplomacy", "expected_crosswalk": "M-FR-002"},
    {"id": "CAL-019", "text": "La guerre du Vietnam montre les limites de la coercition.", "expected_reference": "vietnam-war", "expected_attribution": "provisional", "expected_mechanism": "coercion", "expected_crosswalk": "M-FR-001"},
    {"id": "CAL-020", "text": "La guerra de Vietnam terminó después de una larga intervención estadounidense.", "expected_reference": "vietnam-war", "expected_attribution": "provisional", "expected_mechanism": "coercion", "expected_crosswalk": "M-FR-001"},
    {"id": "CAL-021", "text": "The Cold War, uh, the cold wore as the transcript renders it, shaped the alliance system.", "expected_reference": "cold-war", "expected_attribution": "provisional", "expected_mechanism": "power", "expected_crosswalk": "M-FR-003"},
