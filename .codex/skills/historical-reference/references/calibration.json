    {"id": "CAL-005", "text": "The Iranian Revolution remains part of Iran's sovereignty narrative.", "expected_reference": "iranian-revolution", "expected_attribution": "provisional", "expected_mechanism": "legitimacy", "expected_crosswalk": "M-FR-005"},
    {"id": "CAL-006", "text": "**Chas Freeman:** The Bay of Pigs was a failed intervention.", "expected_reference": "bay-of-pigs", "expected_attribution": "direct", "expected_mechanism": "coercion", "expected_crosswalk": "M-FR-001"},
