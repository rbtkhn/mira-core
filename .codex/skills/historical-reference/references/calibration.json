    {"id": "CAL-001", "text": "The 2003 Iraq War remains a warning about regime change.", "expected_reference": "iraq-war", "expected_attribution": "provisional", "expected_mechanism": "coercion", "expected_crosswalk": "M-FR-001"},
    {"id": "CAL-002", "text": "The Cold War bipolar order shaped the alliance system.", "expected_reference": "cold-war", "expected_attribution": "provisional", "expected_mechanism": "power", "expected_crosswalk": "M-FR-003"},
    {"id": "CAL-003", "text": "The JCPOA demonstrated the value of negotiated limits.", "expected_reference": "jcpoa", "expected_attribution": "provisional", "expected_mechanism": "diplomacy", "expected_crosswalk": "M-FR-002"},
