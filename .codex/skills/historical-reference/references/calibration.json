    {"id": "CAL-010", "text": "The 2018 withdrawal from the JCPOA damaged treaty reliability.", "expected_reference": "jcpoa", "expected_attribution": "provisional", "expected_mechanism": "diplomacy", "expected_crosswalk": "M-FR-002"},
    {"id": "CAL-011", "text": "The new restaurant is called Cold War Kitchen, but the discussion is about food prices.", "expected_reference": null, "expected_attribution": "provisional", "expected_mechanism": null, "expected_crosswalk": null},
    {"id": "CAL-012", "text": "The Iraq office released a report on today's electricity outage.", "expected_reference": null, "expected_attribution": "provisional", "expected_mechanism": null, "expected_crosswalk": null},
