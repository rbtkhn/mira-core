{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mira.local/schemas/session-memorial.schema.json","title":"Mira Session Memorial Sidecar","type":"object","required":["schema_version","memorial_id","version_id","version","status","session_id","capture_refs","record_refs","markdown_path","markdown_sha256","evidence_class","activation_posture","authority_boundary","significance_reasons","retention_reason","decision_attribution","producer","reopening_conditions","counter_memory_refs","omissions","manual_privacy_review","operator_command_receipt","previous_version"],"properties":{"schema_version":{"const":1},"memorial_id":{"pattern":"^MSM-[A-Za-z0-9][A-Za-z0-9-]{5,63}$"},"version_id":{"pattern":"^MSMV-[A-Za-z0-9][A-Za-z0-9-]{5,63}-v[1-9][0-9]*$"},"version":{"type":"integer","minimum":1},"status":{"enum":["admitted","pending"]},"activation_posture":{"const":"inactive"},"evidence_class":{"const":"session-memorial-interpretation"},"significance_reasons":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["consequential-decision","correction","method-change","relational-development","unresolved-inheritance"]}},"retention_reason":{"type":"string","minLength":1},"previous_version":{"type":["object","null"]}},"additionalProperties":true}
