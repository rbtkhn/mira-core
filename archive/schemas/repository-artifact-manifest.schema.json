{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:narrative-systems:system-archive:repository-artifact-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collection_id", "manifest_id", "authority_boundary", "document_count", "documents"],
  "properties": {
    "schema_version": {"const": 1},
    "collection_id": {"type": "string"},
    "manifest_id": {"type": "string"},
    "authority_boundary": {"type": "string"},
    "document_count": {"type": "integer", "minimum": 0},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "document_type", "observed_at", "derived_from", "may_promote"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "document_type": {"enum": ["baseline-audit", "validation-receipt", "outcome-measurement"]},
          "observed_at": {"type": "string"},
          "derived_from": {"type": "array", "items": {"type": "string"}},
          "may_promote": {"const": false}
        }
      }
    }
  }
}
