{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mira-library-integration-v2.schema.json",
  "title": "Mira Library Work Integration v2",
  "description": "Versioned contracts for explicit note-to-work relations, route-note bindings, and their deterministic indexes. The v1 schema remains available for compatibility reads.",
  "oneOf": [
    { "$ref": "#/$defs/profile" },
    { "$ref": "#/$defs/coverage" },
    { "$ref": "#/$defs/routing" },
    { "$ref": "#/$defs/topics" },
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/note" },
    { "$ref": "#/$defs/workRegistry" },
    { "$ref": "#/$defs/routeIndex" },
    { "$ref": "#/$defs/noteLinkIndex" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schema_version", "artifact_id", "canonical_work_id", "library_source_id", "artifact_version", "status", "authority_boundary"],
      "properties": {
        "schema_version": { "type": "string" },
        "artifact_id": { "type": "string", "minLength": 1 },
        "canonical_work_id": { "type": "string", "minLength": 1 },
        "library_source_id": { "type": "string", "minLength": 1 },
        "artifact_version": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "authority_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "profile": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["identity", "work_form", "knowledge_basis", "synopsis", "intellectual_affordances", "textual_basis", "confidence", "essay_refs"],
          "properties": {
            "schema_version": { "const": "mira-library-work-profile-v1" },
            "knowledge_basis": { "const": "knowledge-seeded" },
            "external_research_used": { "const": false },
            "essay_refs": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "coverage": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["coverage_scope", "coverage_decision", "search_scope", "direct_objects_opened", "external_research_authorized", "external_research_used", "unresolved_gaps"],
          "properties": {
            "schema_version": { "const": "mira-library-civmem-coverage-v1" },
            "coverage_decision": { "enum": ["sufficient", "partial", "none", "blocked"] },
            "external_research_used": { "const": false }
          }
        }
      ]
    },
    "routing": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["route_units", "negative_route_rules", "coverage_constraints", "note_revision_state"],
          "properties": {
            "schema_version": { "const": "mira-library-routing-packet-v1" },
            "route_units": { "type": "array" },
            "note_revision_state": { "enum": ["current", "review-suggested", "revision-due", "blocked"] }
          }
        }
      ]
    },
    "topics": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["topics", "essay_refs", "essay_artifacts_created"],
          "properties": {
            "schema_version": { "const": "mira-library-essay-topic-contracts-v1" },
            "topics": { "type": "array", "minItems": 3, "maxItems": 3 },
            "essay_refs": { "type": "array", "items": { "type": "string" } },
            "essay_artifacts_created": { "const": 0 }
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "required": ["schema_version", "pilot_id", "status", "works", "essay_artifacts_created"],
      "properties": {
        "schema_version": { "const": "mira-library-integration-manifest-v1" },
        "works": { "type": "array", "minItems": 5, "maxItems": 5 },
        "essay_artifacts_created": { "const": 0 }
      }
    },
    "libraryRelation": {
      "type": "object",
      "required": ["target_type", "target_id", "relation_type", "role", "explanation"],
      "properties": {
        "target_type": { "const": "library-work" },
        "target_id": { "type": "string", "minLength": 1 },
        "relation_type": { "enum": ["interprets", "questions", "contrasts", "connects", "applies", "revises"] },
        "role": { "enum": ["focal", "comparative", "supporting"] },
        "explanation": { "type": "string", "minLength": 1 },
        "passage_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "required": ["schema_version", "artifact_id", "artifact_type", "artifact_version", "canonical_work_id", "library_source_id", "status", "dependency_snapshot", "library_relations", "authority_boundary"],
      "properties": {
        "schema_version": { "const": "mira-library-integration-note-v2" },
        "artifact_type": { "const": "integration-note" },
        "library_relations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/libraryRelation" } }
      }
    },
    "noteBinding": {
      "type": "object",
      "required": ["note_ref", "note_sha256", "note_dependency_sha256"],
      "properties": {
        "note_ref": { "type": "string", "minLength": 1 },
        "note_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "note_dependency_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "workRegistry": {
      "type": "object",
      "required": ["schema_version", "status", "works", "authority_boundary"],
      "properties": {
        "schema_version": { "const": "mira-library-work-registry-v2" },
        "status": { "const": "current" },
        "works": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["canonical_work_id", "library_source_id", "artifact_root", "revision_head_note_ref", "note_ref", "note_refs", "essay_refs", "route_reviews"],
            "properties": {
              "revision_head_note_ref": { "type": "string", "minLength": 1 },
              "note_ref": { "type": "string", "minLength": 1 },
              "note_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "essay_refs": { "type": "array", "items": { "type": "string" } },
              "route_reviews": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["route_handle", "mechanism_signatures", "note_refs", "review_disposition", "review_binding"],
                  "properties": {
                    "note_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                    "review_disposition": { "enum": ["unreviewed", "approved-internal", "rejected", "blocked-source"] },
                    "review_binding": {
                      "oneOf": [
                        { "type": "null" },
                        {
                          "type": "object",
                          "required": ["route_unit_sha256", "note_bindings", "body_digests"],
                          "properties": {
                            "note_bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/noteBinding" } }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "routeIndex": {
      "type": "object",
      "required": ["schema_version", "status", "generated_from", "route_count", "eligible_route_count", "routes", "works", "authority_boundary"],
      "properties": {
        "schema_version": { "const": "mira-library-route-index-v2" },
        "status": { "const": "current" },
        "route_count": { "type": "integer", "minimum": 0 },
        "eligible_route_count": { "type": "integer", "minimum": 0 },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["route_id", "route_handle", "canonical_work_id", "library_source_id", "library_refs", "body_refs", "route_packet_ref", "note_bindings", "note_ref", "note_revision_state", "packet_status", "route_unit_legacy_state", "review_disposition", "review_binding_status", "mechanism_signatures", "work_integration_stage", "notebook_eligibility", "ineligibility_reasons", "boundary"],
            "properties": {
              "route_id": { "type": "string", "pattern": "^MIRA-ROUTE-[A-Z0-9-]+$" },
              "note_bindings": { "type": "array", "minItems": 1 },
              "notebook_eligibility": { "enum": ["eligible", "ineligible"] },
              "review_disposition": { "enum": ["unreviewed", "approved-internal", "rejected", "blocked-source"] },
              "review_binding_status": { "enum": ["not-applicable", "current", "stale"] },
              "work_integration_stage": { "enum": ["profiled", "pressure-test-ready", "fully-integrated", "stale"] }
            }
          }
        }
      }
    },
    "noteLinkIndex": {
      "type": "object",
      "required": ["schema_version", "status", "generated_from", "note_count", "link_count", "links", "works", "authority_boundary"],
      "properties": {
        "schema_version": { "const": "mira-library-note-link-index-v2" },
        "status": { "const": "current" },
        "note_count": { "type": "integer", "minimum": 0 },
        "link_count": { "type": "integer", "minimum": 0 },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["link_id", "note_id", "note_ref", "note_sha256", "note_dependency_sha256", "source_work_id", "target_type", "target_id", "relation_type", "role", "explanation", "passage_refs", "lineage_position"],
            "properties": {
              "link_id": { "type": "string", "pattern": "^MIRA-LINK-[0-9A-F]{20}$" },
              "lineage_position": { "enum": ["head", "ancestor"] }
            }
          }
        }
      }
    }
  }
}
